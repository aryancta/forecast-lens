# ForecastLens environment variables (all optional - app works out of the box)

# Backend
DATABASE_URL=sqlite:///./forecast_lens.db
ENABLE_LIVE_INGEST=false

# Frontend -> Backend
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_BASE=/api/backend

# Optional API keys (not required for demo - app falls back to bundled samples)
POLYMARKET_API_KEY=
KALSHI_API_KEY=
METACULUS_API_KEY=
